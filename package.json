{
  "name": "dsh-memory-dba",
  "version": "0.1.1",
  "description": "File-based, git-portable long-term memory for DeepSeek Harness: core/stream/workspace layers, BM25 retrieval with CJK bigrams, two-section prompt injection",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TNong611/dsh-memory-dba.git"
  },
  "homepage": "https://github.com/TNong611/dsh-memory-dba#readme",
  "bugs": {
    "url": "https://github.com/TNong611/dsh-memory-dba/issues"
  },
  "type": "module",
  "main": "src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./store": "./src/store.mjs",
    "./search": "./src/search.mjs",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-memory-dba": "bin/cli.mjs"
  },
  "files": [
    "src",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "memory",
    "agent-memory",
    "bm25"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  }
}
